# Anthropic API key used server-side only (never exposed to the browser).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key, server-side only. Required only for agents whose skills/*.md
# frontmatter sets `provider: openai` (default provider is anthropic — see CLAUDE.md).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OmniRoute — free, self-hosted, MIT-licensed multi-provider LLM gateway (see docker-compose.yml).
# Required only for agents whose skills/*.md frontmatter sets `provider: omniroute`.
# Local dev (omniroute run separately, e.g. `npx omniroute` or its own docker container):
#   OMNIROUTE_BASE_URL=http://localhost:20128/v1
# Docker deployment (this repo's docker-compose.yml omniroute service, same network):
#   OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_BASE_URL=
# Only needed once auth is turned on for your OmniRoute instance (Dashboard → Endpoints).
# Leave empty to use OmniRoute's built-in keyless free providers.
OMNIROUTE_API_KEY=

# Docker deployments only (docker-compose.yml): host port to expose. Optional, defaults to 3000.
# APP_PORT=3000

# HTTP Basic Auth for the whole app. If either is left empty, the auth gate is skipped
# (so local dev without a .env stays usable). Set both to protect a public deployment.
APP_USERNAME=
APP_PASSWORD=
